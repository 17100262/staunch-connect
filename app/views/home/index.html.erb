<% content_for :title, "Home" %>

<header class="page-header">
  <h1 class="page-title">Home</h1>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash[:alert] %>

<section class="banner" aria-labelledby="home-banner">
  <div class="banner-body">
    <h2 class="banner-title" id="home-banner">Connect your first data source</h2>
    <p class="banner-desc">Link Hubstaff and ClickUp to start building your consolidated task view. Other sources unlock as they come online.</p>
    <div class="banner-actions">
      <%= link_to connections_path, class: "btn btn-primary" do %><%= icon "plus" %>Connect sources<% end %>
    </div>
  </div>
  <div class="banner-aside">
    <span class="avatar-group">
      <span class="avatar" data-size="lg" data-tone="info">HS</span>
      <span class="avatar" data-size="lg" data-tone="brand">CU</span>
      <span class="avatar" data-size="lg" data-tone="success">FA</span>
    </span>
    <span class="caption">Hubstaff, ClickUp, Fathom</span>
  </div>
</section>
