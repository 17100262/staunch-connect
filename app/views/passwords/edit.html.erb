<% content_for :title, "Update password" %>

<div class="auth-card">
  <div class="auth-head">
    <span class="avatar" data-tone="brand">SC</span>
    <h1 class="page-title">Update your password</h1>
  </div>

  <%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

  <%= form_with url: password_path(params[:token]), method: :put, class: "form-stack" do |form| %>
    <div class="field">
      <label class="field-label" for="password">New password</label>
      <div class="input" data-size="lg">
        <%= form.password_field :password, id: "password", required: true, autocomplete: "new-password", placeholder: "Enter new password", maxlength: 72 %>
      </div>
    </div>

    <div class="field">
      <label class="field-label" for="password_confirmation">Confirm password</label>
      <div class="input" data-size="lg">
        <%= form.password_field :password_confirmation, id: "password_confirmation", required: true, autocomplete: "new-password", placeholder: "Repeat new password", maxlength: 72 %>
      </div>
    </div>

    <%= form.button "Save password", type: :submit, class: "btn btn-primary btn-block", data: { size: "lg" } %>
  <% end %>
</div>
