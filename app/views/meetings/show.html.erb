<% content_for :title, @meeting.title.presence || "Untitled meeting" %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Meetings", meetings_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= @meeting.title.presence || "Untitled meeting" %></span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title"><%= @meeting.title.presence || "Untitled meeting" %></h1>
    <p class="page-desc">
      <%= @meeting.recorded_at ? @meeting.recorded_at.strftime("%B %-d, %Y") : "Date unknown" %>
      <% if @meeting.duration_minutes.present? %> · <%= @meeting.duration_minutes %> min<% end %>
    </p>
  </div>
  <div class="page-actions">
    <% if @meeting.fathom_url.present? %>
      <%= link_to @meeting.fathom_url, target: "_blank", rel: "noopener", class: "btn btn-secondary" do %><%= icon "video" %>View in Fathom<% end %>
    <% else %>
      <span class="caption">Fathom link unavailable</span>
    <% end %>
  </div>
</header>

<% if attendee_names(@meeting).any? %>
  <div class="card">
    <div class="card-body">
      <dl class="kv">
        <dt>Attendees</dt><dd><%= attendee_names(@meeting).join(", ") %></dd>
      </dl>
    </div>
  </div>
<% end %>

<div class="card">
  <div class="card-header"><h2 class="card-title">Summary</h2></div>
  <div class="card-body">
    <% if @meeting.summary.present? %>
      <div class="prose"><%= markdown_to_html(@meeting.summary) %></div>
    <% else %>
      <p class="caption"><%= @meeting.processing? ? "Still processing in Fathom. Check back soon." : "No summary generated." %></p>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2 class="card-title">Transcript</h2></div>
  <div class="card-body">
    <% if @meeting.transcript.present? %>
      <div class="transcript body-base"><%= @meeting.transcript %></div>
    <% else %>
      <p class="caption"><%= @meeting.processing? ? "Still processing in Fathom. Check back soon." : "No transcript available." %></p>
    <% end %>
  </div>
</div>
