<% content_for :title, "Meetings" %>
<% content_for :subtitle do %>Transcripts and summaries synced from Fathom<% end %>

<div class="p-8 flex flex-col gap-6">
  <% if @meetings.empty? && @query.blank? %>
    <div class="h-full flex items-center justify-center p-8">
      <div class="w-full max-w-[480px] bg-white border border-slate-200 rounded-2xl shadow-sm p-7">
        <div class="flex items-start gap-3">
          <span class="flex-none w-10 h-10 rounded-xl bg-brand-50 text-brand-400 flex items-center justify-center">
            <i class="ph ph-video-camera text-xl"></i>
          </span>
          <div class="min-w-0">
            <div class="font-bold text-base text-slate-900">No meetings yet</div>
            <div class="mt-0.5 text-sm text-slate-600 leading-relaxed">
              Connect Fathom in Settings, then click "Sync Now" to pull in your meetings — new ones will sync automatically from there.
            </div>
          </div>
        </div>

        <div class="mt-6">
          <%= link_to "Connect Fathom", connections_path, class: "inline-flex items-center gap-2 h-10 px-4 rounded-lg bg-brand-400 hover:bg-brand-500 text-white font-semibold text-sm" %>
        </div>
      </div>
    </div>
  <% else %>
    <%= form_with url: meetings_path, method: :get, class: "flex items-center gap-3" do |form| %>
      <div class="relative w-full max-w-sm">
        <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
        <%= form.text_field :q, value: @query, placeholder: "Search by title or attendee…",
              class: "w-full h-10 pl-9 pr-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-brand-400" %>
      </div>
      <%= form.submit "Search", class: "h-10 px-4 rounded-lg text-sm font-semibold bg-white border border-slate-200 text-slate-900 hover:bg-slate-50 cursor-pointer" %>
      <% if @query.present? %>
        <%= link_to "Clear", meetings_path, class: "text-sm font-semibold text-slate-500 hover:text-slate-700" %>
      <% end %>
    <% end %>

    <% if @meetings.empty? %>
      <div class="bg-white border border-slate-200 rounded-2xl shadow-sm p-6 text-sm text-slate-600">
        No meetings match "<%= @query %>".
      </div>
    <% else %>
    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse table-fixed">
          <colgroup>
            <col>
            <col style="width: 150px">
            <col style="width: 240px">
            <col style="width: 90px">
          </colgroup>
          <thead>
            <tr class="bg-slate-50 text-xs font-semibold uppercase tracking-wider text-slate-500">
              <th class="text-left px-4 py-3 font-semibold">Meeting</th>
              <th class="text-left px-4 py-3 font-semibold">Date</th>
              <th class="text-left px-4 py-3 font-semibold">Attendees</th>
              <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @meetings.each do |meeting| %>
              <tr class="border-t border-slate-200 hover:bg-slate-50">
                <td class="px-4 py-3 overflow-hidden">
                  <div class="text-slate-900 font-medium truncate"><%= meeting.title.presence || "Untitled meeting" %></div>
                  <% if meeting.processing? %>
                    <div class="text-xs text-amber-600 mt-0.5">Still processing in Fathom</div>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-slate-600 whitespace-nowrap"><%= meeting.recorded_at ? meeting.recorded_at.strftime("%b %-d, %Y") : "—" %></td>
                <td class="px-4 py-3 text-slate-600 truncate"><%= Array(meeting.attendees).map { |a| a.is_a?(Hash) ? (a["name"] || a["email"]) : a }.compact.join(", ").presence || "—" %></td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <%= link_to "View →", meeting_path(meeting), class: "text-brand-400 font-semibold hover:text-brand-500" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
    <% end %>
  <% end %>
</div>
