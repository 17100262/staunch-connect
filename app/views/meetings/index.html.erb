<% content_for :title, "Meetings" %>

<header class="page-header">
  <h1 class="page-title">Meetings</h1>
</header>

<% if @meetings.empty? && @query.blank? %>
  <div class="empty" data-variant="bordered">
    <div class="empty-icon"><%= icon "video" %></div>
    <h3 class="empty-title">No meetings yet</h3>
    <p class="empty-desc">Connect Fathom in Settings, then click Sync now to pull in your meetings. New ones sync automatically after that.</p>
    <div class="empty-actions"><%= link_to "Connect Fathom", connections_path, class: "btn btn-primary" %></div>
  </div>
<% else %>
  <%= form_with url: meetings_path, method: :get, class: "filter-bar", role: "search" do |form| %>
    <div class="input" data-size="sm">
      <%= icon "search" %>
      <%= form.search_field :q, value: @query, placeholder: "Search by title or attendee", aria: { label: "Search meetings" } %>
    </div>
    <% if @query.present? %>
      <%= link_to "Clear", meetings_path, class: "btn btn-ghost", data: { size: "sm" } %>
    <% end %>
  <% end %>

  <% if @meetings.empty? %>
    <div class="empty" data-size="sm">
      <div class="empty-icon"><%= icon "search" %></div>
      <h3 class="empty-title">No meetings match</h3>
      <p class="empty-desc">Nothing matches "<%= @query %>". Try a different title or attendee name.</p>
    </div>
  <% else %>
    <div class="table-card" data-variant="open">
      <div class="table-scroll" tabindex="0" role="region" aria-label="Meetings">
        <table class="table">
          <caption class="sr-only">Meetings</caption>
          <thead>
            <tr>
              <th scope="col">Meeting</th>
              <th scope="col">Date</th>
              <th scope="col">Attendees</th>
              <th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
            </tr>
          </thead>
          <tbody>
            <% @meetings.each do |meeting| %>
              <tr>
                <td>
                  <div class="cell-primary">
                    <%= link_to (meeting.title.presence || "Untitled meeting"), meeting_path(meeting) %>
                    <% if meeting.processing? %>
                      <span class="badge" data-tone="warning"><span class="badge-dot"></span>Processing</span>
                    <% end %>
                  </div>
                </td>
                <td class="cell-secondary"><%= meeting.recorded_at ? meeting.recorded_at.strftime("%-d %b %Y") : "—" %></td>
                <td class="cell-secondary cell-truncate"><%= attendee_names(meeting).join(", ").presence || "—" %></td>
                <td class="col-actions">
                  <%= link_to meeting_path(meeting), class: "btn btn-ghost", data: { size: "sm" } do %>View<%= icon "chevron-right" %><% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% end %>
<% end %>
