<section aria-label="Password">
  <%= form_with url: settings_password_path, method: :patch, class: "sm-stack", data: { controller: "password-rules", action: "input->password-rules#check" } do %>
    <div class="field">
      <label class="field-label" for="pw-cur">Current password</label>
      <div class="input">
        <input id="pw-cur" name="current_password" type="password" autocomplete="current-password" required data-password-rules-target="field">
        <button type="button" class="icon-btn btn-ghost" data-size="sm" aria-label="Show or hide passwords" data-action="password-rules#reveal"><%= icon "eye" %></button>
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="pw-new">New password</label>
      <div class="input">
        <input id="pw-new" name="password" type="password" autocomplete="new-password" required data-password-rules-target="field newPassword">
        <button type="button" class="icon-btn btn-ghost" data-size="sm" aria-label="Show or hide passwords" data-action="password-rules#reveal"><%= icon "eye" %></button>
      </div>
    </div>
    <ul class="rules" aria-label="Password rules">
      <% [ [ "At least 12 characters", "length" ], [ "At least one number", "number" ], [ "At least one symbol", "symbol" ] ].each do |text, key| %>
        <li class="rule" data-password-rules-target="rule" data-rule="<%= key %>">
          <span data-met hidden><%= icon "circle-check" %><span class="sr-only">Met: </span></span>
          <span data-unmet><%= icon "minus" %><span class="sr-only">Not met: </span></span>
          <span><%= text %></span>
        </li>
      <% end %>
    </ul>
    <div class="field">
      <label class="field-label" for="pw-con">Confirm new password</label>
      <div class="input" data-password-rules-target="confirmBox">
        <input id="pw-con" name="password_confirmation" type="password" autocomplete="new-password" required aria-describedby="pw-c-e" data-password-rules-target="field confirm">
        <button type="button" class="icon-btn btn-ghost" data-size="sm" aria-label="Show or hide passwords" data-action="password-rules#reveal"><%= icon "eye" %></button>
      </div>
      <div class="field-error" id="pw-c-e" hidden data-password-rules-target="mismatch"><%= icon "circle-alert" %><span>Passwords do not match.</span></div>
    </div>
    <div class="sm-edit-actions"><button type="submit" class="btn btn-primary" disabled data-password-rules-target="submit">Update password</button></div>
  <% end %>
</section>
