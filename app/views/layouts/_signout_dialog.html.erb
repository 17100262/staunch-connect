<div class="scrim" hidden data-dialogs-target="scrim" data-name="signout" data-action="click->dialogs#backdrop keydown.esc->dialogs#close">
  <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="so-t" aria-describedby="so-d" data-size="sm">
    <div class="panel-header">
      <span class="panel-icon" aria-hidden="true"><%= icon "log-out" %></span>
      <div class="panel-heading">
        <h2 class="panel-title" id="so-t">Sign out of Staunch Connect?</h2>
        <p class="panel-desc" id="so-d">Your invoices, chats and connectors stay as they are. You will need to sign in again to come back.</p>
      </div>
    </div>
    <div class="panel-footer">
      <button type="button" class="btn btn-secondary" data-action="dialogs#close">Cancel</button>
      <%= button_to "Sign out", session_path, method: :delete, class: "btn btn-primary", form: { class: "inline-form" } %>
    </div>
  </div>
</div>
