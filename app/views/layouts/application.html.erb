<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <%= render "shared/icons" %>

    <div class="app" data-layout="panel" <%= "data-fixed" if content_for?(:full_bleed) %> data-controller="sidebar search dialogs" data-action="keydown@window->search#shortcut">
      <%= render "layouts/sidebar" %>

      <div class="app-main">
        <div class="app-body">
          <%= yield :topbar %>
          <% if content_for?(:full_bleed) %>
            <%= yield %>
          <% else %>
            <main class="page <%= yield :page_class %>">
              <%= yield %>
            </main>
          <% end %>
        </div>
      </div>

      <%= render "layouts/search_dialog" %>
      <%= render "layouts/signout_dialog" %>
      <turbo-frame id="modal"<%= %( src="#{ERB::Util.html_escape(@modal_src)}").html_safe if @modal_src %>></turbo-frame>
      <%= render "shared/toast" %>
    </div>
  </body>
</html>
