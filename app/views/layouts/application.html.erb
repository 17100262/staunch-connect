<!DOCTYPE html>
<html>
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <%= render "shared/icons" %>

    <div class="app" data-layout="panel" data-controller="sidebar search" data-action="keydown@window->search#shortcut">
      <%= render "layouts/sidebar" %>

      <div class="app-main">
        <div class="app-body">
          <main class="page">
            <%= yield %>
          </main>
        </div>
      </div>

      <%= render "layouts/search_dialog" %>
      <turbo-frame id="modal"></turbo-frame>
      <%= render "shared/toast" %>
    </div>
  </body>
</html>
