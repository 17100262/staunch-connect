<header class="h-14 flex-none flex items-center px-6 bg-white border-b border-slate-200">
  <div class="flex-1 min-w-0 flex flex-col justify-center">
    <span class="font-display font-bold text-[17px] text-slate-900 truncate">
      <%= content_for(:title) || "Staunch Connect" %>
    </span>
    <% if content_for?(:subtitle) %>
      <span class="text-xs text-slate-600"><%= yield :subtitle %></span>
    <% end %>
  </div>
</header>
