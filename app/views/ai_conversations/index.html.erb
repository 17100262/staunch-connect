<% content_for :title, "AI Assistant" %>

<header class="page-header">
  <h1 class="page-title">AI Assistant</h1>
  <div class="page-actions">
    <%= button_to ai_conversations_path, class: "btn btn-primary" do %><%= icon "plus" %>New conversation<% end %>
  </div>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<% if @conversations.empty? %>
  <div class="empty" data-variant="bordered">
    <div class="empty-icon"><%= icon "sparkles" %></div>
    <h3 class="empty-title">Ask about your invoices and meetings</h3>
    <p class="empty-desc">Try "What was the total for the August invoice?" or "Which meeting discussed the AWS migration?"</p>
  </div>
<% else %>
  <div class="table-card" data-variant="open">
    <div class="table-scroll" tabindex="0" role="region" aria-label="Conversations">
      <table class="table">
        <caption class="sr-only">Conversations</caption>
        <thead>
          <tr>
            <th scope="col">Conversation</th>
            <th scope="col">Last activity</th>
            <th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @conversations.each do |conversation| %>
            <tr>
              <td><div class="cell-primary"><%= link_to (conversation.title.presence || "New conversation"), ai_conversation_path(conversation) %></div></td>
              <td class="cell-secondary"><%= conversation.updated_at.strftime("%-d %b %Y, %-I:%M %p") %></td>
              <td class="col-actions">
                <%= button_to ai_conversation_path(conversation), method: :delete, class: "icon-btn btn-ghost", data: { size: "sm" }, aria: { label: "Delete conversation" }, form: { data: { turbo_confirm: "Delete this conversation? This can't be undone." } } do %><%= icon "trash" %><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
