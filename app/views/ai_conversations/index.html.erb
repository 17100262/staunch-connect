<% content_for :title, "AI Assistant" %>
<% content_for :full_bleed, true %>

<div class="cx" data-controller="chatlist">
  <%= render "chat_list", conversations: @conversations, current: nil, query: @query %>

  <section class="cx-main" aria-labelledby="t-chat">
    <%= render "cx_head", conversation: nil, title: "New chat", sub: assistant_sub %>

    <%= tag.div flash_alerts, class: "flash-stack cx-flash" if flash[:alert] %>

    <div class="cx-scroll cx-scroll-flex" data-controller="chat">
      <% if !@ai_ready %>
        <%= render "ai_gate" %>
        <div id="messages" data-chat-target="messages" hidden><div id="chat_bottom" data-chat-target="bottom"></div></div>
      <% elsif @sources_connected %>
        <div class="cx-empty" id="empty_hint">
          <span class="tile" data-size="lg" data-tone="primary" aria-hidden="true"><%= icon "sparkles" %></span>
          <h2 class="t-heading-md" style="margin:0">What do you want to know?</h2>
          <p class="cx-sub">Ask about invoices, meetings or task time. Answers come from your synced data.</p>
        </div>
        <div id="messages" class="chat-thread" role="log" aria-live="polite" data-chat-target="messages" hidden>
          <div id="chat_bottom" data-chat-target="bottom"></div>
        </div>
      <% else %>
        <%= render "gate" %>
        <div id="messages" data-chat-target="messages" hidden><div id="chat_bottom" data-chat-target="bottom"></div></div>
      <% end %>
    </div>

    <div class="cx-dock">
      <%= render "composer", url: ai_conversations_path, enabled: (@sources_connected && @ai_ready) %>
      <p class="caption cx-note">Answers draw on synced Fathom meetings, ClickUp tasks and Hubstaff time.</p>
    </div>
  </section>
</div>
