<% content_for :title, @conversation.title.presence || "AI Assistant" %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "AI Assistant", ai_conversations_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= @conversation.title.presence || "New conversation" %></span></li>
</ol></nav>

<div class="chat-page" data-controller="chat">
  <div id="messages" class="chat-thread" role="log" aria-live="polite" data-chat-target="messages">
    <% if @conversation.ai_messages.empty? %>
      <div id="empty_hint" class="empty" data-size="sm">
        <div class="empty-icon"><%= icon "sparkles" %></div>
        <h3 class="empty-title">Ask about your invoices and meetings</h3>
        <p class="empty-desc">Try "What was the total for the August invoice?" or "What are my open action items this week?"</p>
      </div>
    <% end %>

    <%= render partial: "message", collection: @conversation.ai_messages, as: :message %>

    <div id="chat_bottom" data-chat-target="bottom"></div>
  </div>

  <div class="chat-composer">
    <%= render "message_form", conversation: @conversation %>
  </div>
</div>
