<% if message.role == "user" %>
  <div class="msg-user pre-wrap"><%= message.content %></div>
<% else %>
  <div class="msg-ai">
    <span class="avatar" data-size="sm" data-tone="brand"><%= icon "sparkles" %></span>
    <div class="msg-body">
      <p class="pre-wrap"><%= message.content %></p>
      <% if message.tool_calls.present? %>
        <details class="tool-calls">
          <summary class="caption">Data used (<%= pluralize(message.tool_calls.size, "lookup") %>)</summary>
          <% message.tool_calls.each do |call| %>
            <div class="tool-call code">
              <div><strong><%= call["name"] %></strong>(<%= call["input"].to_json %>)</div>
              <div class="pre-wrap"><%= JSON.pretty_generate(call["result"]) %></div>
            </div>
          <% end %>
        </details>
      <% end %>
    </div>
  </div>
<% end %>
