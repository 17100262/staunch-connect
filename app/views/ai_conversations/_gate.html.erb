<div class="nv-gate">
  <section class="banner" data-layout="stacked" aria-labelledby="bn-bot">
    <div class="banner-body">
      <h2 class="banner-title" id="bn-bot">The assistant needs something to read</h2>
      <p class="banner-desc">It answers from your own invoices, meetings and tasks. Connect at least one source and ask it anything.</p>
      <div class="banner-actions"><%= link_to connections_path, class: "btn btn-primary" do %><%= icon "plus" %>Connect sources<% end %></div>
    </div>
    <div class="banner-aside">
      <span class="avatar-group">
        <span class="avatar" data-size="lg" data-tone="info">HS</span>
        <span class="avatar" data-size="lg" data-tone="brand">CU</span>
        <span class="avatar" data-size="lg" data-tone="success">FA</span>
      </span>
      <span class="caption">Hubstaff, ClickUp, Fathom</span>
    </div>
  </section>
</div>
