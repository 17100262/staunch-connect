<%= form_with url: ai_conversation_messages_path(conversation), method: :post, id: "message_form", class: "sticky bottom-8 flex items-end gap-3 bg-white border border-slate-200 rounded-2xl shadow-sm p-3" do |form| %>
  <%= form.text_area :question, rows: 1, placeholder: "Ask about an invoice…", class: "flex-1 resize-none border-0 focus:ring-0 focus:outline-none text-[15px] text-slate-900 placeholder:text-slate-400 py-2 px-2", required: true, autofocus: true %>
  <%= form.submit "Ask", class: "h-10 px-4 rounded-lg bg-brand-400 hover:bg-brand-500 text-white font-semibold text-sm cursor-pointer flex-none" %>
<% end %>
