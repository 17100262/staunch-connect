<%= form_with url: ai_conversation_messages_path(conversation), method: :post, id: "message_form", class: "composer", data: { controller: "composer" } do |form| %>
  <%= form.text_area :question, rows: 1, class: "composer-field", placeholder: "Ask about invoices or meetings", required: true, autofocus: true, aria: { label: "Message" }, data: { composer_target: "field", action: "input->composer#grow keydown->composer#submitOnEnter" } %>
  <div class="composer-tools">
    <button type="submit" class="icon-btn btn-primary composer-send" data-size="sm" aria-label="Send"><%= icon "arrow-up" %></button>
  </div>
<% end %>
