<% content_for :title, "Invoicing" %>

<header class="page-header">
  <h1 class="page-title">Invoicing</h1>
  <div class="page-actions">
    <%= link_to invoicing_path, class: "btn btn-primary" do %><%= icon "plus" %>Create invoice<% end %>
  </div>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<% if @invoices.empty? %>
  <div class="empty" data-variant="bordered">
    <div class="empty-icon"><%= icon "file" %></div>
    <h3 class="empty-title">No invoices yet</h3>
    <p class="empty-desc">Build a reconciliation from a ClickUp project's tasks and Hubstaff's logged hours, then save it as an invoice.</p>
    <div class="empty-actions"><%= link_to invoicing_path, class: "btn btn-primary" do %><%= icon "plus" %>Create invoice<% end %></div>
  </div>
<% else %>
  <div class="table-card" data-variant="open">
    <div class="table-scroll" tabindex="0" role="region" aria-label="Invoices">
      <table class="table">
        <caption class="sr-only">Invoices</caption>
        <thead>
          <tr>
            <th scope="col">Invoice</th>
            <th scope="col">Billing period</th>
            <th scope="col" class="num">Hours</th>
            <th scope="col" class="num">Billed</th>
            <th scope="col" class="col-actions"><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @invoices.each do |invoice| %>
            <tr>
              <td><div class="cell-primary"><%= link_to invoice.name, invoice_path(invoice) %></div></td>
              <td class="cell-secondary"><%= Date.strptime(invoice.month, "%Y-%m").strftime("%B %Y") %></td>
              <td class="cell-secondary num"><%= number_with_precision(invoice.total_estimate_hours, precision: 1) %>h</td>
              <td class="num"><%= number_to_currency(invoice.total_amount) %></td>
              <td class="col-actions">
                <%= link_to "View", invoice_path(invoice), class: "btn btn-ghost", data: { size: "sm" } %>
                <%= button_to invoice_path(invoice), method: :delete, class: "icon-btn btn-ghost", data: { size: "sm" }, aria: { label: "Delete #{invoice.name}" }, form: { class: "inline-form", data: { turbo_confirm: "Delete this invoice? This can't be undone." } } do %><%= icon "trash" %><% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
