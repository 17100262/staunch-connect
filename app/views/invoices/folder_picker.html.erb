<% content_for :title, "Invoicing" %>
<% content_for :subtitle do %>Select a client and billing period to build a reconciliation<% end %>

<div class="h-full flex items-center justify-center p-8">
  <div class="w-full max-w-[480px] bg-white border border-slate-200 rounded-2xl shadow-sm p-7">
    <% if alert = flash[:alert] %>
      <p class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg mb-4"><%= alert %></p>
    <% end %>

    <div class="flex items-start gap-3 mb-5">
      <span class="flex-none w-10 h-10 rounded-xl bg-brand-50 text-brand-400 flex items-center justify-center">
        <i class="ph ph-folder text-xl"></i>
      </span>
      <div class="min-w-0">
        <div class="font-bold text-base text-slate-900"><%= @clickup_space_name || @clickup_space_id %></div>
        <div class="mt-0.5 text-sm text-slate-600 leading-relaxed">Pick the client/project within this workspace to build a reconciliation for.</div>
      </div>
    </div>

    <% if @folders.empty? && @folderless_lists.empty? %>
      <p class="text-sm text-slate-500">No projects found in this workspace.</p>
    <% else %>
      <div class="flex flex-col gap-2 max-h-[360px] overflow-auto pr-1">
        <% @folders.each do |folder| %>
          <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name, clickup_folder_id: folder["id"], clickup_folder_name: folder["name"]), class: "flex items-center justify-between gap-2 px-4 py-3 rounded-lg border border-slate-200 hover:border-brand-400 hover:bg-brand-25 text-sm font-semibold text-slate-900" do %>
            <%= folder["name"] %>
            <i class="ph ph-arrow-right text-base text-slate-400"></i>
          <% end %>
        <% end %>

        <% if @folderless_lists.present? %>
          <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name, clickup_folder_id: InvoicesController::NO_FOLDER), class: "flex items-center justify-between gap-2 px-4 py-3 rounded-lg border border-slate-200 hover:border-brand-400 hover:bg-brand-25 text-sm font-semibold text-slate-900" do %>
            No Folder
            <i class="ph ph-arrow-right text-base text-slate-400"></i>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="mt-4">
      <%= link_to "Back to workspaces", invoicing_path, class: "text-sm text-slate-500 hover:text-slate-700" %>
    </div>
  </div>
</div>
