<% content_for :title, "New invoice" %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Invoicing", invoices_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><%= link_to "New invoice", invoicing_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= @clickup_space_name || @clickup_space_id %></span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title">New invoice</h1>
    <p class="page-desc"><%= @clickup_space_name || @clickup_space_id %></p>
  </div>
</header>

<%= render "invoices/flow_steps", current: 2 %>
<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<div class="card flow-card">
  <div class="card-header">
    <div><h2 class="card-title">Choose a client</h2><p class="card-desc">Pick the client or project within this workspace.</p></div>
  </div>
  <div class="card-body">
    <% if @folders.empty? && @folderless_lists.empty? %>
      <div class="empty" data-size="sm">
        <div class="empty-icon"><%= icon "folder" %></div>
        <h3 class="empty-title">No clients found</h3>
        <p class="empty-desc">This workspace has no folders or lists yet.</p>
      </div>
    <% else %>
      <div class="pick-list">
        <% @folders.each do |folder| %>
          <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name, clickup_folder_id: folder["id"], clickup_folder_name: folder["name"]), class: "card", data: { padding: "sm", interactive: true } do %>
            <span class="pick-row">
              <span class="pick-lead"><span class="tile"><%= icon "folder" %></span><span class="label-base"><%= folder["name"] %></span></span>
              <%= icon "chevron-right" %>
            </span>
          <% end %>
        <% end %>

        <% if @folderless_lists.present? %>
          <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name, clickup_folder_id: InvoicesController::NO_FOLDER), class: "card", data: { padding: "sm", interactive: true } do %>
            <span class="pick-row">
              <span class="pick-lead"><span class="tile"><%= icon "list" %></span><span class="label-base">No folder</span></span>
              <%= icon "chevron-right" %>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="card-footer">
    <%= link_to invoicing_path, class: "btn btn-ghost" do %><%= icon "chevron-left" %>Back<% end %>
  </div>
</div>
