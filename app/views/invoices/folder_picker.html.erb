<% content_for :title, "Invoicing" %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Invoicing", invoices_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><%= link_to "New invoice", invoicing_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= @clickup_space_name || @clickup_space_id %></span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title"><%= @clickup_space_name || @clickup_space_id %></h1>
    <p class="page-desc">Pick the client or project within this workspace to build a reconciliation for.</p>
  </div>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<% if @folders.empty? && @folderless_lists.empty? %>
  <div class="empty" data-size="sm">
    <div class="empty-icon"><%= icon "folder" %></div>
    <h3 class="empty-title">No projects found</h3>
    <p class="empty-desc">No projects were found in this workspace.</p>
  </div>
<% else %>
  <div class="pick-list narrow">
    <% @folders.each do |folder| %>
      <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name, clickup_folder_id: folder["id"], clickup_folder_name: folder["name"]), class: "card", data: { padding: "sm" } do %>
        <span class="pick-row"><span class="label-base"><%= folder["name"] %></span><%= icon "arrow-right" %></span>
      <% end %>
    <% end %>

    <% if @folderless_lists.present? %>
      <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name, clickup_folder_id: InvoicesController::NO_FOLDER), class: "card", data: { padding: "sm" } do %>
        <span class="pick-row"><span class="label-base">No folder</span><%= icon "arrow-right" %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
