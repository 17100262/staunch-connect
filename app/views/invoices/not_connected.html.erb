<% content_for :title, "Invoicing" %>

<header class="page-header"><h1 class="page-title">Invoicing</h1></header>

<div class="empty" data-variant="bordered">
  <div class="empty-icon"><%= icon "plug" %></div>
  <h3 class="empty-title">Connect Hubstaff and ClickUp first</h3>
  <p class="empty-desc">
    Invoicing needs both sources connected: one for estimates, one for logged hours.
    <% unless @clickup_connection&.connected? %>ClickUp isn't connected.<% end %>
    <% unless @hubstaff_connection&.connected? %>Hubstaff isn't connected.<% end %>
  </p>
  <div class="empty-actions"><%= link_to "Go to connector settings", connections_path, class: "btn btn-primary" %></div>
</div>
