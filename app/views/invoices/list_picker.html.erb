<% content_for :title, "Invoicing" %>
<% project_name = @mapping.clickup_folder_name.presence || (@mapping.clickup_folder_id ? @mapping.clickup_folder_id : "No folder") %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Invoicing", invoices_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><%= link_to "New invoice", invoicing_path(clickup_space_id: @clickup_space_id) %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= project_name %></span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title"><%= project_name %></h1>
    <p class="page-desc">Mapped to Hubstaff project "<%= @mapping.hubstaff_project_name %>"</p>
  </div>
  <div class="page-actions">
    <%= button_to "Remap", project_mapping_path(@mapping), method: :delete, class: "btn btn-secondary", form: { data: { turbo_confirm: "Remap this project?" } } %>
  </div>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<%= form_with url: invoicing_draft_path, method: :get, class: "form-stack narrow" do |form| %>
  <%= form.hidden_field :clickup_space_id, value: @clickup_space_id %>
  <%= form.hidden_field :clickup_folder_id, value: @clickup_folder_id %>

  <% if @lists.empty? %>
    <div class="empty" data-size="sm">
      <div class="empty-icon"><%= icon "list-checks" %></div>
      <h3 class="empty-title">No lists found</h3>
      <p class="empty-desc">This project has no lists to reconcile.</p>
    </div>
  <% else %>
    <fieldset class="choice-group check-list">
      <legend class="field-label">Lists to include</legend>
      <% @lists.each do |list| %>
        <label class="check">
          <input type="checkbox" name="list_ids[]" value="<%= list["id"] %>">
          <span class="check-box"><%= icon "check", class: "i-check" %><%= icon "minus", class: "i-minus" %></span>
          <span class="check-text"><span><%= list["name"] %></span></span>
        </label>
      <% end %>
    </fieldset>
    <%= form.button "Build reconciliation", type: :submit, class: "btn btn-primary btn-block" %>
  <% end %>

  <%= link_to invoicing_path(clickup_space_id: @clickup_space_id), class: "btn btn-ghost" do %><%= icon "chevron-left" %>Back to projects<% end %>
<% end %>
