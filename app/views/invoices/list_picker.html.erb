<% content_for :title, "Invoicing" %>
<% content_for :subtitle do %>Select a client and billing period to build a reconciliation<% end %>

<div class="h-full flex items-center justify-center p-8">
  <div class="w-full max-w-[560px] bg-white border border-slate-200 rounded-2xl shadow-sm p-7">
    <% if alert = flash[:alert] %>
      <p class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg mb-4"><%= alert %></p>
    <% end %>

    <div class="flex items-start justify-between gap-3 mb-5">
      <div class="flex items-start gap-3 min-w-0">
        <span class="flex-none w-10 h-10 rounded-xl bg-brand-50 text-brand-400 flex items-center justify-center">
          <i class="ph ph-list-checks text-xl"></i>
        </span>
        <div class="min-w-0">
          <div class="font-bold text-base text-slate-900"><%= @mapping.clickup_folder_name.presence || (@mapping.clickup_folder_id ? @mapping.clickup_folder_id : "No Folder") %></div>
          <div class="mt-0.5 text-sm text-slate-600">Mapped to Hubstaff project "<%= @mapping.hubstaff_project_name %>"</div>
        </div>
      </div>
      <%= button_to "Remap", project_mapping_path(@mapping), method: :delete, class: "flex-none text-xs font-semibold text-slate-500 hover:text-slate-700 bg-transparent border-0 cursor-pointer p-0", form: { data: { turbo_confirm: "Remap this project?" } } %>
    </div>

    <%= form_with url: invoicing_draft_path, method: :get, class: "flex flex-col gap-4" do |form| %>
      <%= form.hidden_field :clickup_space_id, value: @clickup_space_id %>
      <%= form.hidden_field :clickup_folder_id, value: @clickup_folder_id %>

      <% if @lists.empty? %>
        <p class="text-sm text-slate-500">No lists found for this project.</p>
      <% else %>
        <div class="max-h-[360px] overflow-auto flex flex-col gap-1.5 pr-1">
          <% @lists.each do |list| %>
            <label class="flex items-center gap-2.5 text-sm text-slate-900">
              <input type="checkbox" name="list_ids[]" value="<%= list["id"] %>" class="rounded border-slate-300 text-brand-400 focus:ring-brand-400">
              <%= list["name"] %>
            </label>
          <% end %>
        </div>
      <% end %>

      <%= form.submit "Build Reconciliation", class: "w-full h-11 rounded-lg bg-brand-400 hover:bg-brand-500 text-white font-semibold text-sm cursor-pointer" %>
    <% end %>

    <div class="mt-4">
      <%= link_to "Back to projects", invoicing_path(clickup_space_id: @clickup_space_id), class: "text-sm text-slate-500 hover:text-slate-700" %>
    </div>
  </div>
</div>
