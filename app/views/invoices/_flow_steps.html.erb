<%# New-invoice flow progress (SC Stepper). current: 1 Project, 2 Client, 3 Lists, 4 Review. %>
<% steps = [
  [ "Project", "ClickUp workspace" ],
  [ "Client", "Folder and Hubstaff mapping" ],
  [ "Lists", "Choose what to bill" ],
  [ "Review", "Check and save" ]
] %>
<ol class="stepper" aria-label="New invoice progress">
  <% steps.each_with_index do |(title, desc), i| %>
    <% n = i + 1 %>
    <% state = n < current ? "done" : (n == current ? "current" : "upcoming") %>
    <%= tag.li class: "step", data: { state: state }, aria: { current: (state == "current" ? "step" : nil) } do %>
      <span class="step-marker"><%= state == "done" ? icon("check") : n %></span>
      <span class="step-text">
        <span class="step-title"><% if state == "done" %><span class="sr-only">Completed: </span><% end %><%= title %></span>
        <span class="step-desc"><%= desc %></span>
      </span>
    <% end %>
  <% end %>
</ol>
