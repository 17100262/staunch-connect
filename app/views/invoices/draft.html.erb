<% content_for :title, "Invoicing" %>
<% project_name = @mapping.clickup_folder_name.presence || @mapping.clickup_space_name.presence || @clickup_space_id %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Invoicing", invoices_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= project_name %></span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title">New invoice</h1>
    <p class="page-desc"><%= project_name %> · Hubstaff project "<%= @mapping.hubstaff_project_name %>"</p>
  </div>
  <%= form_with url: invoicing_draft_path, method: :get, class: "page-actions" do |form| %>
    <%= form.hidden_field :clickup_space_id, value: @clickup_space_id %>
    <%= form.hidden_field :clickup_folder_id, value: @clickup_folder_id %>
    <% @list_ids.each do |list_id| %>
      <%= hidden_field_tag "list_ids[]", list_id %>
    <% end %>
    <div class="field">
      <label class="field-label" for="month">Billing period</label>
      <div class="select" data-size="sm">
        <select name="month" id="month" onchange="this.form.requestSubmit()">
          <% @month_options.each do |value, label| %>
            <option value="<%= value %>" <%= "selected" if value == @month %>><%= label %></option>
          <% end %>
        </select>
        <%= icon "chevron-down" %>
      </div>
    </div>
  <% end %>
</header>

<%= render "invoices/flow_steps", current: 4 %>
<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<div class="stats">
  <div class="stat-cell"><div class="stat"><span class="stat-label">Estimated</span><span class="stat-value"><%= number_with_precision(@total_estimate_hours, precision: 1) %>h</span></div></div>
  <div class="stat-cell"><div class="stat"><span class="stat-label">Logged (Hubstaff)</span><span class="stat-value"><%= number_with_precision(@total_logged_hours, precision: 1) %>h</span></div></div>
  <div class="stat-cell"><div class="stat"><span class="stat-label">Invoice total</span><span class="stat-value"><%= number_to_currency(@total_amount) %></span></div></div>
</div>

<% unless @mapping.default_hourly_rate %>
  <div class="alert" role="status" data-tone="warning">
    <%= icon "triangle-alert" %>
    <div class="alert-content">No hourly rate is set for this project, so amounts show as $0.00. Set one on the <%= link_to "project mapping", invoicing_path(clickup_space_id: @clickup_space_id, clickup_folder_id: @clickup_folder_id), class: "link" %>.</div>
  </div>
<% end %>

<div class="table-card">
  <div class="table-scroll" tabindex="0" role="region" aria-label="Tasks">
    <table class="table">
      <caption class="sr-only">Tasks</caption>
      <thead>
        <tr>
          <th scope="col">Task</th>
          <th scope="col">Ticket</th>
          <th scope="col" class="num">Estimate</th>
          <th scope="col" class="num">Rate</th>
          <th scope="col" class="num">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% if @line_items.empty? %>
          <tr><td colspan="5" class="cell-secondary">No tasks found in the selected list(s).</td></tr>
        <% else %>
          <% @line_items.each do |item| %>
            <% amount = (item[:estimate_hours] || 0) * (@mapping.default_hourly_rate || 0) %>
            <% subtask_titles = item[:notes].to_s.split("\n").map { |line| line.delete_prefix("• ") } %>
            <tr>
              <td>
                <div class="cell-primary"><span><%= item[:title] %></span></div>
                <% if subtask_titles.any? %>
                  <details>
                    <summary class="label-sm"><%= pluralize(subtask_titles.size, "subtask") %></summary>
                    <ul class="sub-list">
                      <% subtask_titles.each do |title| %><li><%= title %></li><% end %>
                    </ul>
                  </details>
                <% end %>
              </td>
              <td class="cell-secondary code"><%= item[:ticket] %></td>
              <td class="cell-secondary num"><%= item[:estimate_hours] ? "#{number_with_precision(item[:estimate_hours], precision: 1)}h" : "—" %></td>
              <td class="cell-secondary num"><%= @mapping.default_hourly_rate ? number_to_currency(@mapping.default_hourly_rate) : "—" %></td>
              <td class="num"><%= number_to_currency(amount) %></td>
            </tr>
          <% end %>
          <tr class="table-total">
            <td colspan="4" class="num">Total</td>
            <td class="num"><%= number_to_currency(@total_amount) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

<div class="toolbar-split">
  <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_folder_id: @clickup_folder_id), class: "btn btn-ghost" do %><%= icon "chevron-left" %>Back to project<% end %>

  <% if @line_items.any? %>
    <%= form_with url: invoices_path, method: :post do |form| %>
      <%= form.hidden_field :clickup_space_id, value: @clickup_space_id %>
      <%= form.hidden_field :clickup_folder_id, value: @clickup_folder_id %>
      <% @list_ids.each do |list_id| %>
        <%= hidden_field_tag "list_ids[]", list_id %>
      <% end %>
      <%= form.hidden_field :month, value: @month %>
      <%= form.button "Save as invoice", type: :submit, class: "btn btn-primary" %>
    <% end %>
  <% end %>
</div>
