<%# Carries the setup chosen so far through the next step. `except` names fields the step sets itself. %>
<% skip = Array(local_assigns[:except]).map(&:to_s) %>
<% @setup.each do |key, value| %>
  <% next if skip.include?(key) %>
  <% if key == "list_ids" %>
    <% value.each do |id| %><%= hidden_field_tag "list_ids[]", id, id: nil %><% end %>
  <% elsif value.present? %>
    <%= hidden_field_tag key, value, id: nil %>
  <% end %>
<% end %>
