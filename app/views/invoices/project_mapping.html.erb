<% content_for :title, "New invoice" %>
<% project_name = @clickup_folder_name.presence || (@clickup_folder_id == InvoicesController::NO_FOLDER ? "No folder" : @clickup_folder_id) %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Invoicing", invoices_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><%= link_to "New invoice", invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name) %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= project_name %></span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title">New invoice</h1>
    <p class="page-desc"><%= project_name %></p>
  </div>
</header>

<%= render "invoices/flow_steps", current: 2 %>
<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<div class="card flow-card">
  <div class="card-header">
    <div>
      <h2 class="card-title">Map "<%= project_name %>" to Hubstaff</h2>
      <p class="card-desc">Which Hubstaff project should we total logged hours from for this client? You only need to do this once.</p>
    </div>
  </div>

  <% if @hubstaff_project_options.empty? %>
    <div class="card-body">
      <div class="empty" data-size="sm">
        <div class="empty-icon"><%= icon "link" %></div>
        <h3 class="empty-title">No Hubstaff projects found</h3>
        <p class="empty-desc">Check the Hubstaff connection in Settings, then try again.</p>
        <div class="empty-actions"><%= link_to "Open settings", connections_path, class: "btn btn-secondary" %></div>
      </div>
    </div>
    <div class="card-footer">
      <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name), class: "btn btn-ghost" do %><%= icon "chevron-left" %>Back<% end %>
    </div>
  <% else %>
    <%= form_with url: project_mappings_path, method: :post do |form| %>
      <%= form.hidden_field :clickup_space_id, value: @clickup_space_id %>
      <%= form.hidden_field :clickup_space_name, value: @clickup_space_name %>
      <%= form.hidden_field :clickup_folder_id, value: @clickup_folder_id %>
      <%= form.hidden_field :clickup_folder_name, value: @clickup_folder_name %>

      <div class="card-body form-stack">
        <div class="field">
          <label class="field-label" for="hubstaff_project_value">Hubstaff project <span class="field-req" aria-hidden="true">*</span></label>
          <div class="select">
            <select name="hubstaff_project_value" id="hubstaff_project_value" required>
              <option value="" disabled selected hidden>Select a project</option>
              <% @hubstaff_project_options.each do |option| %>
                <option value="<%= option[:id] %>|<%= option[:name] %>"><%= option[:name] %></option>
              <% end %>
            </select>
            <%= icon "chevron-down" %>
          </div>
        </div>

        <div class="field">
          <label class="field-label" for="default_hourly_rate">Hourly rate</label>
          <div class="input">
            <span class="input-affix">$</span>
            <%= form.number_field :default_hourly_rate, id: "default_hourly_rate", step: 0.01, min: 0, placeholder: "0.00", aria: { describedby: "rate-hint" } %>
          </div>
          <div class="field-hint" id="rate-hint">Optional. Used as the default for this project's line items.</div>
        </div>
      </div>

      <div class="card-footer">
        <%= link_to invoicing_path(clickup_space_id: @clickup_space_id, clickup_space_name: @clickup_space_name), class: "btn btn-ghost" do %><%= icon "chevron-left" %>Back<% end %>
        <%= form.button "Save mapping", type: :submit, class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>
