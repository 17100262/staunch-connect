<% content_for :title, "Invoicing" %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Invoicing", invoices_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page">New invoice</span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title">New invoice</h1>
    <p class="page-desc">Pick the ClickUp project to build a reconciliation for.</p>
  </div>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<% if @spaces.empty? %>
  <div class="empty" data-size="sm">
    <div class="empty-icon"><%= icon "folder" %></div>
    <h3 class="empty-title">No ClickUp projects found</h3>
    <p class="empty-desc">No projects were found for this workspace.</p>
  </div>
<% else %>
  <div class="pick-list narrow">
    <% @spaces.each do |space| %>
      <%= link_to invoicing_path(clickup_space_id: space["id"], clickup_space_name: space["name"]), class: "card", data: { padding: "sm" } do %>
        <span class="pick-row"><span class="label-base"><%= space["name"] %></span><%= icon "arrow-right" %></span>
      <% end %>
    <% end %>
  </div>
<% end %>
