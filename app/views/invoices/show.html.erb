<% content_for :title, @invoice.name %>

<nav class="breadcrumb" aria-label="Breadcrumb"><ol>
  <li><%= link_to "Invoicing", invoices_path %><span class="breadcrumb-sep" aria-hidden="true"><%= icon "chevron-right" %></span></li>
  <li><span aria-current="page"><%= @invoice.name %></span></li>
</ol></nav>

<header class="page-header">
  <div>
    <h1 class="page-title"><%= @invoice.name %></h1>
    <p class="page-desc"><%= Date.strptime(@invoice.month, "%Y-%m").strftime("%B %Y") %> · Mapped to Hubstaff project "<%= @invoice.project_mapping.hubstaff_project_name %>"</p>
  </div>
  <div class="page-actions">
    <%= button_to invoice_path(@invoice), method: :delete, class: "btn btn-secondary", form: { data: { turbo_confirm: "Delete this invoice? This can't be undone." } } do %><%= icon "trash" %>Delete invoice<% end %>
    <%= link_to export_invoice_path(@invoice), class: "btn btn-secondary" do %><%= icon "download" %>Export XLSX<% end %>
  </div>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash.any? %>

<%= form_with model: @invoice, class: "form-stack" do |form| %>
  <div class="field narrow">
    <label class="field-label" for="invoice_name">Invoice name</label>
    <div class="input"><%= form.text_field :name, id: "invoice_name" %></div>
  </div>

  <div class="table-card">
    <div class="table-scroll" tabindex="0" role="region" aria-label="Line items">
      <table class="table">
        <caption class="sr-only">Line items</caption>
        <thead>
          <tr>
            <th scope="col">Task</th>
            <th scope="col">Ticket</th>
            <th scope="col" class="num">Estimate</th>
            <th scope="col" class="num">Rate</th>
            <th scope="col" class="num">Amount</th>
            <th scope="col">Bill</th>
          </tr>
        </thead>
        <tbody>
          <% if @invoice.invoice_line_items.empty? %>
            <tr><td colspan="6" class="cell-secondary">This invoice has no line items.</td></tr>
          <% else %>
            <%= form.fields_for :invoice_line_items do |line_form| %>
              <% item = line_form.object %>
              <tr class="<%= "row-muted" unless item.billable %>">
                <td>
                  <div class="input" data-size="sm"><%= line_form.text_field :title, aria: { label: "Task title" } %></div>
                  <details>
                    <summary class="label-sm"><%= item.notes.present? ? pluralize(item.notes.lines.count, "subtask") : "Add notes" %></summary>
                    <%= line_form.text_area :notes, rows: 3, class: "textarea", placeholder: "Subtasks or other notes for this line item", aria: { label: "Notes" } %>
                  </details>
                </td>
                <td class="cell-secondary code"><%= item.ticket %></td>
                <td class="cell-secondary num"><%= number_with_precision(item.estimate_hours, precision: 1) %>h</td>
                <td class="num"><div class="input" data-size="sm"><%= line_form.number_field :hourly_rate, step: 0.01, min: 0, aria: { label: "Hourly rate" } %></div></td>
                <td class="num"><%= number_to_currency(item.amount) %></td>
                <td>
                  <label class="check">
                    <%= line_form.check_box :billable, aria: { label: "Bill #{item.title}" } %>
                    <span class="check-box"><%= icon "check", class: "i-check" %><%= icon "minus", class: "i-minus" %></span>
                  </label>
                </td>
              </tr>
            <% end %>
            <tr class="table-total">
              <td colspan="4" class="num">Total</td>
              <td class="num"><%= number_to_currency(@invoice.total_amount) %></td>
              <td></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="toolbar-split">
    <%= link_to invoices_path, class: "btn btn-ghost" do %><%= icon "chevron-left" %>Back to invoices<% end %>
    <%= form.button "Save changes", type: :submit, class: "btn btn-primary" %>
  </div>
<% end %>
