<% content_for :title, "Connector settings" %>

<% source_icons = { "hubstaff" => "clock", "clickup" => "square-check", "fathom" => "video" } %>
<% auth_labels = { "hubstaff" => "Personal token", "clickup" => "Personal token", "fathom" => "API key" } %>
<% status_tones = { "connected" => "success", "error" => "danger", "syncing" => "info" } %>
<% soon_sources = [ { name: "Slack", initials: "Sl" }, { name: "GitHub", initials: "GH" }, { name: "Gmail", initials: "Gm" } ] %>

<header class="page-header">
  <h1 class="page-title">Connector settings</h1>
</header>

<%= tag.div flash_alerts, class: "flash-stack" if flash[:alert] %>

<div class="card-grid">
  <% @connections.each do |source, connection| %>
    <% status = connection&.status || "disconnected" %>
    <div class="card">
      <div class="card-header">
        <div class="head-start">
          <span class="tile" data-tone="primary"><%= icon source_icons[source] %></span>
          <div>
            <h2 class="card-title"><%= source.capitalize %></h2>
            <p class="card-desc">
              <% if status == "syncing" %>
                Syncing in the background…
              <% elsif status == "connected" %>
                Connected · last synced <%= time_ago_in_words(connection.last_used_at) %> ago
              <% elsif status == "error" %>
                <%= connection.last_error %>
              <% else %>
                Not connected yet
              <% end %>
            </p>
          </div>
        </div>
        <span class="badge" data-tone="<%= status_tones[status] %>">
          <% if status == "syncing" %><%= icon "loader", class: "spin" %><% else %><span class="badge-dot"></span><% end %>
          <%= status.tr("_", " ").capitalize %>
        </span>
      </div>

      <div class="card-body form-stack">
        <div class="card-meta">
          <span class="label-sm"><%= auth_labels[source] %></span>
          <span class="caption"><%= connection&.last_used_at ? "Last synced #{time_ago_in_words(connection.last_used_at)} ago" : "Never synced" %></span>
        </div>

        <% if source == "fathom" && connection&.connected? %>
          <% if connection.webhook_id.present? %>
            <div class="alert" data-tone="success"><%= icon "circle-check" %><div class="alert-content">Webhook registered. New meetings sync automatically.</div></div>
          <% else %>
            <div class="alert" data-tone="warning"><%= icon "triangle-alert" %><div class="alert-content">No webhook registered. Use Sync now to pull meetings.</div></div>
          <% end %>
        <% end %>

        <%= form_with url: connections_path, method: :post, class: "card-form" do |form| %>
          <%= form.hidden_field :source, value: source %>
          <div class="input" data-size="sm">
            <%= form.password_field :credential, placeholder: connection&.connected? ? "Replace token" : "Enter API token", aria: { label: "#{source.capitalize} #{auth_labels[source].downcase}" } %>
          </div>
          <%= form.button (connection&.connected? ? "Update" : "Connect"), type: :submit, class: "btn btn-primary", data: { size: "sm" } %>
        <% end %>
      </div>

      <% if connection.present? %>
        <div class="card-footer">
          <%= button_to (connection.syncing? ? "Syncing…" : "Sync now"), sync_connection_path(connection), method: :post, disabled: connection.syncing?, class: "btn btn-secondary", data: { size: "sm" }, form: { class: "inline-form" } %>
          <%= button_to "Disconnect", connection_path(connection), method: :delete, class: "btn btn-ghost", data: { size: "sm" }, form: { class: "inline-form", data: { turbo_confirm: "Disconnect #{source.capitalize}?" } } %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% soon_sources.each do |s| %>
    <div class="card" data-variant="flat">
      <div class="card-header">
        <div class="head-start">
          <span class="tile"><%= s[:initials] %></span>
          <div>
            <h2 class="card-title"><%= s[:name] %></h2>
            <p class="card-desc">Not available in this phase</p>
          </div>
        </div>
        <span class="badge">Coming soon</span>
      </div>
      <div class="card-footer">
        <button type="button" class="btn btn-secondary" data-size="sm" disabled>Connect</button>
      </div>
    </div>
  <% end %>
</div>
