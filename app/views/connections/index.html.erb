<% content_for :title, "Connector Settings" %>
<% content_for :subtitle do %>Manage source connections, sync, and access<% end %>

<% icons = { "hubstaff" => "clock-counter-clockwise", "clickup" => "check-square-offset", "fathom" => "video-camera" } %>
<% auth_labels = { "hubstaff" => "Personal Token", "clickup" => "Personal Token", "fathom" => "API Key" } %>
<% soon_sources = [
  { name: "Slack", icon: "slack-logo" },
  { name: "GitHub", icon: "github-logo" },
  { name: "Gmail", icon: "envelope-simple" }
] %>

<div class="p-8 flex flex-col gap-8">
  <% if alert = flash[:alert] %>
    <p class="py-2 px-3 bg-red-50 text-red-500 font-medium rounded-lg inline-block" id="alert"><%= alert %></p>
  <% end %>

  <% if notice = flash[:notice] %>
    <p class="py-2 px-3 bg-green-50 text-green-500 font-medium rounded-lg inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div>
    <div class="font-bold text-sm text-slate-900 mb-3">Sources</div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <% @connections.each do |source, connection| %>
        <% status = connection&.status || "disconnected" %>
        <div class="min-w-0 bg-white border border-slate-200 rounded-2xl shadow-sm p-5 flex flex-col gap-3">
          <div class="flex items-start gap-3 flex-wrap">
            <span class="flex-none w-10 h-10 rounded-xl bg-brand-50 text-brand-400 flex items-center justify-center">
              <i class="ph ph-<%= icons[source] %> text-xl"></i>
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-[15px] text-slate-900 capitalize"><%= source %></span>
                <span class="inline-flex items-center h-5 px-2 rounded-full text-xs font-semibold <%=
                  case status
                  when "connected" then "bg-green-100 text-green-700"
                  when "error" then "bg-red-100 text-red-700"
                  when "syncing" then "bg-blue-100 text-blue-700"
                  else "bg-slate-200 text-slate-700"
                  end
                %>">
                  <%= status.tr("_", " ").capitalize %>
                </span>
              </div>
              <div class="text-[13px] text-slate-600 mt-0.5">
                <% if status == "syncing" %>
                  Syncing in the background&hellip;
                <% elsif status == "connected" %>
                  Connected &middot; last synced <%= time_ago_in_words(connection.last_used_at) %> ago
                <% elsif status == "error" %>
                  <%= connection.last_error %>
                <% else %>
                  Not connected yet
                <% end %>
              </div>
            </div>
          </div>

          <div class="flex items-center justify-between gap-2 flex-wrap">
            <span class="inline-flex items-center h-[22px] px-2.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">
              <%= auth_labels[source] %>
            </span>
            <span class="text-xs text-slate-400">
              <%= connection&.last_used_at ? "Last synced #{time_ago_in_words(connection.last_used_at)} ago" : "Never synced" %>
            </span>
          </div>

          <% if source == "fathom" && connection&.connected? %>
            <div class="text-[13px] text-slate-600 -mt-1">
              <% if connection.webhook_id.present? %>
                <i class="ph ph-check-circle text-green-600"></i> Webhook registered &mdash; new meetings sync automatically
              <% else %>
                <i class="ph ph-warning text-amber-600"></i> No webhook registered &mdash; use Sync Now to pull meetings
              <% end %>
            </div>
          <% end %>

          <div class="flex items-center justify-end gap-2 flex-wrap pt-2 border-t border-slate-200">
            <% if connection.present? %>
              <%= button_to connection.syncing? ? "Syncing…" : "Sync Now", sync_connection_path(connection), method: :post, disabled: connection.syncing?, class: "h-8 px-3 rounded-lg text-sm font-semibold bg-white border border-slate-200 text-slate-900 hover:bg-slate-50 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed" %>
              <%= button_to "Disconnect", connection_path(connection), method: :delete, class: "h-8 px-3 rounded-lg text-sm font-semibold bg-transparent text-red-600 hover:bg-slate-100 cursor-pointer", form: { data: { turbo_confirm: "Disconnect #{source.capitalize}?" } } %>
            <% end %>
          </div>

          <%= form_with url: connections_path, method: :post, class: "flex gap-2" do |form| %>
            <%= form.hidden_field :source, value: source %>
            <%= form.password_field :credential, placeholder: connection&.connected? ? "Replace token" : "Enter API token", class: "flex-1 min-w-0 h-9 px-3 bg-slate-50 border border-slate-200 rounded-lg text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-brand-400" %>
            <%= form.submit connection&.connected? ? "Update" : "Connect", class: "h-9 px-3 rounded-lg text-sm font-semibold bg-brand-400 hover:bg-brand-500 text-white cursor-pointer" %>
          <% end %>
        </div>
      <% end %>

      <% soon_sources.each do |s| %>
        <div class="min-w-0 bg-white border border-slate-200 rounded-2xl shadow-sm p-5 flex flex-col gap-3 opacity-55">
          <div class="flex items-start gap-3 flex-wrap">
            <span class="flex-none w-10 h-10 rounded-xl bg-brand-50 text-brand-400 flex items-center justify-center">
              <i class="ph ph-<%= s[:icon] %> text-xl"></i>
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="font-bold text-[15px] text-slate-900"><%= s[:name] %></span>
                <span class="inline-flex items-center h-5 px-2 rounded-full text-xs font-semibold bg-slate-200 text-slate-700">Coming Soon</span>
              </div>
              <div class="text-[13px] text-slate-600 mt-0.5">Not available in this phase</div>
            </div>
          </div>

          <div class="flex items-center justify-between gap-2 flex-wrap">
            <span class="inline-flex items-center h-[22px] px-2.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200">&mdash;</span>
            <span class="text-xs text-slate-400">&mdash;</span>
          </div>

          <div class="flex items-center justify-end pt-2 border-t border-slate-200">
            <button type="button" disabled class="h-8 px-3 rounded-lg text-sm font-semibold bg-white border border-slate-200 text-slate-400 cursor-not-allowed">Connect</button>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
